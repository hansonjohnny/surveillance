# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Firebase credentials
google-services.json
GoogleService-Info.plist

# Supabase CLI local session state (project ref, pooler URL, tool versions) —
# regenerated per machine by `supabase link` / `supabase start`, not shared state.
supabase/.temp/

# Office lock files (created while a .docx/.pptx is open)
~$*
