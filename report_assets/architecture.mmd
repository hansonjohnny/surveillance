flowchart TB
    subgraph Device["Mobile Application (Expo / React Native / TypeScript)"]
        UI["Screens: Auth, Onboarding, Home, Live Map, Event Log, Alerts, Settings"]
        Store["Zustand State Stores (session, alerts, settings, onboarding)"]
        Mon["Monitoring Orchestrator (monitoring.ts)"]
        Sensors["Device Sensors: GPS, Camera, Microphone, Accelerometer"]
        Local["AsyncStorage / Secure Store (local cache and secrets)"]
        UI --> Store
        Store --> Mon
        Mon --> Sensors
        Sensors --> Mon
        Store --> Local
    end

